{
  "name": "shree-keshar-plastic",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "EMAIL_ENABLED": "true",
    "EMAIL_TRANSPORT": "hostinger-api",
    "HOSTINGER_MAILBOX_ID": "ACf0a6eae4f9536122cb10b0bfd5ec",
    "STAGING_ORIGIN": "https://shree-keshar-plastic.autumn-haze-c280.workers.dev"
  },
  "ratelimits": [
    { "name": "ENQUIRY_RATE_LIMIT", "namespace_id": "72401", "simple": { "limit": 5, "period": 60 } },
    { "name": "ENQUIRY_TOTAL_LIMIT", "namespace_id": "72402", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
